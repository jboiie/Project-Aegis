# ─── Target LLM ───────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Redis (Semantic Cache) ──────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Supabase (Telemetry) ───────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key_here

# ─── Guardrail Settings ─────────────────────────────────────
GUARDRAIL_INJECTION_THRESHOLD=0.85
GUARDRAIL_TOXICITY_THRESHOLD=0.80
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# Layer ablation — set to a subset to disable layers, e.g.:
#   GUARDRAIL_LAYERS=L1            (regex only)
#   GUARDRAIL_LAYERS=L1,L2        (+ DeBERTa)
#   GUARDRAIL_LAYERS=L1,L2,L3    (+ ToxicBERT)
GUARDRAIL_LAYERS=L1,L2,L3,L4

# ─── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ─── Auth (optional) ─────────────────────────────────────────
# Leave empty to disable auth. Set to require `Authorization: Bearer <key>`
# on every /v1 request — recommended if the proxy is reachable outside a
# private network.
AEGIS_API_KEY=
