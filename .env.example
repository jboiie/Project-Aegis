# ─── Target LLM ───────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Redis (Semantic Cache) ──────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Supabase (Telemetry) ───────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key_here

# ─── Guardrail Settings ─────────────────────────────────────
GUARDRAIL_INJECTION_THRESHOLD=0.85
GUARDRAIL_TOXICITY_THRESHOLD=0.80
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# ─── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ─── Red Team (optional — only for attack runner) ───────────
REDTEAM_TARGET_URL=http://localhost:8000/v1/chat/completions
REDTEAM_CONCURRENCY=5
